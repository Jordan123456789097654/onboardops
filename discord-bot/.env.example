# Copy these into the hosting panel's environment settings. Never commit real values.
# The token is shown once in the Discord developer portal. If it is ever pasted anywhere, reset it there.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# The website the bot talks to (optional; this is the default).
SITE_URL=https://www.onboardops.org

# A long random secret shared with the website (the same value as STAFF_BOT_KEY in Vercel).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_BOT_KEY=

# Optional tuning (all times are UTC).
# STALE_TICKET_HOURS=24
# SUMMARY_HOUR_UTC=13
# STANDUP_HOUR_UTC=14
# SIGNUP_SPIKE_PER_HOUR=30
