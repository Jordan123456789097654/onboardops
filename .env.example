# Neon Postgres. DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) string used by `prisma db push`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/onboardops?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/onboardops?sslmode=require"

# Random string, 32+ chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Public base URL used in emails (acknowledgment links).
APP_URL="http://localhost:3000"
# Production: APP_URL="https://onboardops.org"

# Resend (https://resend.com). Leave RESEND_API_KEY empty to skip sending email.
RESEND_API_KEY=""
EMAIL_FROM="OnboardOps <onboarding@resend.dev>"
# Production, after verifying onboardops.org in Resend: EMAIL_FROM="OnboardOps <notifications@onboardops.org>"

# Secret for the daily job (reminders and certificate expiry). Vercel Cron sends it as a Bearer token.
CRON_SECRET=""

# Where support form messages are emailed (needs RESEND_API_KEY). Optional: messages are always saved in the database.
SUPPORT_INBOX=""

# Public contact address shown on the Contact page. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Once the mailbox exists, for example: NEXT_PUBLIC_CONTACT_EMAIL="support@onboardops.org"

# Custom domains for workspaces (optional). Create a Vercel token at vercel.com/account/tokens with access to this project.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
# Only if the project belongs to a Vercel team:
VERCEL_TEAM_ID=""

# Staff console: comma-separated emails that are always OnboardOps staff owners (bootstrap).
PLATFORM_OWNER_EMAILS=""

# Testing only: send EVERY outbound email to this address instead of the real recipient.
EMAIL_REDIRECT_TO=""

# Encrypts customer-supplied credentials such as SMS tokens (falls back to AUDIT_HMAC_KEY, then SESSION_SECRET). Keep stable.
SECRETS_KEY=
# Audit log signing key (keep stable)
AUDIT_HMAC_KEY=

# Workspace addresses (name.onboardops.org). Spaceship key needs only dnsrecords:read and dnsrecords:write.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
# Extra hosts in the zone (comma separated) that the Update DNS targets button should also repoint, besides workspace addresses.
SUBDOMAIN_EXTRA_HOSTS=management
# Optional: wildcard mode if you add a single *.onboardops.org DNS record yourself instead of using the API.
SUBDOMAIN_DNS_MODE=

# Encrypts sensitive records and files before they are stored. 64 hex characters. NEVER change it without running scripts/rotate-master-key.mts, and keep a safe copy.
DATA_MASTER_KEY=
