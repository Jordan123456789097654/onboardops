generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  LOA
  SUSPENDED
  TERMINATED
}

enum Readiness {
  PENDING
  CERTIFIED
  RETRAINING_REQUIRED
}

enum EnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  PASSED
  FAILED
}

enum Severity {
  VERBAL_WARNING
  WRITTEN_INFRACTION
  STRIKE_POINTS
  SUSPENSION
  TERMINATION
}

enum TimelineEventType {
  CREATED
  NOTE_ADDED
  APPEAL_LOGGED
  ACKNOWLEDGED
  RETRAINING_TRIGGERED
}

enum ShiftType {
  OPENING
  MID_SHIFT
  CLOSING
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  createdAt         DateTime          @default(now())
  passwordChangedAt DateTime?
  platformRole      String?
  emailVerifiedAt   DateTime?
  nickname          String?
  passwordSetAt     DateTime?
  avatarData        Bytes?
  avatarMime        String?
  avatarUpdatedAt   DateTime?
  extraEmails       UserEmail[]
  failedLogins      Int               @default(0)
  lockedUntil       DateTime?
  /// Two-factor sign-in. The secret is sealed (secret-box), never stored in plain text.
  totpSecretEnc     String?
  totpPendingEnc    String?
  totpEnabledAt     DateTime?
  totpFailed        Int               @default(0)
  totpLockedUntil   DateTime?
  /// Highest 30-second step already accepted, so a code cannot be used twice.
  totpLastStep      Int?
  backupCodes       BackupCode[]
  oauthAccounts     OAuthAccount[]
  ssoIdentities     SsoIdentity[]
  memberships       WorkspaceMember[]
  tokens            AuthToken[]
  sessions          UserSession[]
  emailPrefs        Json              @default("{}")
  quietStart        Int?
  quietEnd          Int?
  timezone          String?
  /// Set when a moderator bans the account. A banned account cannot sign in or keep a session.
  bannedAt          DateTime?
  banReason         String            @default("")
  moderationCases   ModerationCase[]
}

/// A Google or GitHub identity linked to a user. Sign-in matches on (provider, providerAccountId), never on email alone.
model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  /// "google" | "github"
  provider          String
  /// Google: the stable `sub`. GitHub: the numeric user id.
  providerAccountId String
  email             String?
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

/// Single sign-on for one workspace (Google Workspace or Microsoft Entra ID). The client secret is stored sealed and never shown again.
model WorkspaceSso {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  /// google | entra
  provider        String
  clientId        String
  clientSecretEnc String
  /// Entra only: the tenant (directory) ID.
  tenantId        String?
  domains         String[]
  enabled         Boolean   @default(false)
  /// When on, members on these domains (except owners) must sign in through SSO.
  enforce         Boolean   @default(false)
  /// Set by a successful test sign-in. SSO cannot be enabled until it is set.
  testedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// An email domain claimed by one workspace's SSO. A domain belongs to at most one workspace.
model SsoDomain {
  id          String @id @default(cuid())
  domain      String @unique
  workspaceId String

  @@index([workspaceId])
}

/// Links a person to their identity at the workspace's identity provider. Later sign-ins match on this, not on email.
model SsoIdentity {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  issuer      String
  subject     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, issuer, subject])
  @@index([userId])
}

/// How much AI each workspace used, per month and feature. Counts only: never the text that was sent or received.
model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  /// YYYY-MM
  month        String
  feature      String
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, month, feature])
  @@index([workspaceId, month])
}

/// A customer-supplied encryption key for one workspace. The workspace data key (Workspace.dataKeyEnc) is wrapped by this key.
model WorkspaceCmk {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  /// ACTIVE | REVOKED
  status      String    @default("ACTIVE")
  keyVersion  Int       @default(1)
  /// First 8 hex characters of a digest of the key, so the owner can tell which key is in use. It is not the key.
  fingerprint String
  /// The customer's key, sealed with SECRETS_KEY while the key is ACTIVE. Deleted when the key is revoked.
  kekSealed   String?
  addedAt     DateTime  @default(now())
  rotatedAt   DateTime?
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// One single-use recovery code. Only a keyed hash is stored.
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, codeHash])
}

model Workspace {
  id                             String         @id @default(cuid())
  /// When on, every member must use two-factor sign-in.
  require2fa                     Boolean        @default(false)
  cmk                            WorkspaceCmk?
  sso                            WorkspaceSso?
  name                           String
  slug                           String         @unique
  plan                           Plan           @default(FREE)
  operationsWebhookUrl           String?
  confidentialWebhookUrl         String?
  autoSuspendStrikeThreshold     Int            @default(5)
  autoRetrainOnWrittenInfraction Boolean        @default(true)
  remindersEnabled               Boolean        @default(true)
  suspendedAt                    DateTime?
  customDomain                   String?        @unique
  domainStatus                   String         @default("NONE")
  domainCheckedAt                DateTime?
  domainDetails                  Json?
  staffRequests                  StaffRequest[]
  suspendedReason                String         @default("")
  createdAt                      DateTime       @default(now())

  members              WorkspaceMember[]
  departments          Department[]
  jobRoles             JobRole[]
  employees            EmployeeProfile[]
  courses              Course[]
  enrollments          CourseEnrollment[]
  infractions          InfractionCase[]
  templates            ShiftChecklistTemplate[]
  submissions          ShiftChecklistSubmission[]
  auditLogs            AuditLog[]
  files                StoredFile[]
  policies             Policy[]
  policyAcks           PolicyAcknowledgment[]
  documents            EmployeeDocument[]
  incidents            IncidentReport[]
  reviews              Review[]
  notifications        Notification[]
  features             Json                       @default("{}")
  rolePerms            Json                       @default("{}")
  legalHold            Boolean                    @default(false)
  legalHoldReason      String                     @default("")
  legalHoldAt          DateTime?
  setupDone            Boolean                    @default(false)
  timezone             String                     @default("America/New_York")
  logoData             Bytes?
  logoMime             String?
  logoUpdatedAt        DateTime?
  dataRegion           String                     @default("US")
  singleTenantRef      String?
  retentionPolicies    Json                       @default("{}")
  kmsConfig            Json?
  siemConfig           Json?
  duoConfig            Json?
  externalIntegrations Json                       @default("{}")
  lmsConfig            Json?
  isFranchisor         Boolean                    @default(false)
  franchiseCode        String?                    @unique
  parentWorkspaceId    String?
  franchiseParent      Workspace?                 @relation("FranchiseTree", fields: [parentWorkspaceId], references: [id], onDelete: SetNull)
  franchisees          Workspace[]                @relation("FranchiseTree")
  saml                 WorkspaceSaml?
  scimTokens           ScimToken[]
  siemDeliveries       SiemDelivery[]
  orgUnits             OrgUnit[]
  rolloutWaves         RolloutWave[]
  signatureCerts       SignatureCertificate[]
  investigations       InvestigationCase[]
  xapiStatements       XapiStatement[]
  bulkJobs             BulkJob[]
  customRoles          CustomRole[]
  customFields         CustomField[]
  caseTemplates        CaseTemplate[]
  disciplineRules      DisciplineRule[]
  credentials          Credential[]
  profileChanges       ProfileChangeRequest[]
  appeals              Appeal[]
  handoffNotes         HandoffNote[]
  shifts               Shift[]
  timeEntries          TimeEntry[]
  assets               Asset[]
  genericWebhookUrl    String?
  genericWebhookSecret String                     @default("")
  coachingNotes        CoachingNote[]
  apiKeys              ApiKey[]
  locations            Location[]
  smsAccountSid        String?
  smsAuthTokenEnc      String?
  smsFrom              String?
  bambooSubdomain      String?
  bambooKeyEnc         String?
  subdomain            String?                    @unique
  subdomainStatus      String                     @default("NONE")
  referralCode         String?
  dataKeyEnc           String?
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(EMPLOYEE)
  createdAt   DateTime @default(now())

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile       EmployeeProfile?
  issued        InfractionCase[] @relation("IssuedBy")
  notifications Notification[]
  customRoleId  String?
  customRole    CustomRole?      @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  orgUnitId     String?
  orgUnit       OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Department {
  id              String  @id @default(cuid())
  workspaceId     String
  name            String
  colorCode       String  @default("#52525B")
  managerMemberId String?

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees EmployeeProfile[]
  templates ShiftChecklistTemplate[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model JobRole {
  id                String   @id @default(cuid())
  workspaceId       String
  title             String
  description       String   @default("")
  /// The order of this list is the learning path order.
  requiredCourseIds String[]
  /// When on, each required course unlocks only after the one before it is passed.
  pathSequential    Boolean  @default(false)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees EmployeeProfile[]

  @@index([workspaceId])
}

model EmployeeProfile {
  id                String         @id @default(cuid())
  workspaceId       String
  memberId          String?        @unique
  staffCode         String
  fullName          String
  email             String
  phone             String?
  emergencyContact  String?
  departmentId      String?
  jobRoleId         String?
  status            EmployeeStatus @default(ONBOARDING)
  readiness         Readiness      @default(PENDING)
  strikePoints      Int            @default(0)
  hireDate          DateTime       @default(now())
  shiftAvailability Json           @default("{}")

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member           WorkspaceMember?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  department       Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobRole          JobRole?                   @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  enrollments      CourseEnrollment[]
  quizAttempts     QuizAttempt[]
  infractions      InfractionCase[]
  submissions      ShiftChecklistSubmission[]
  policyAcks       PolicyAcknowledgment[]
  documents        EmployeeDocument[]
  incidents        IncidentReport[]
  reviews          Review[]
  staffRequests    StaffRequest[]
  separationDate   DateTime?
  separationReason String?
  customValues     Json                       @default("{}")
  credentials      Credential[]
  profileChanges   ProfileChangeRequest[]
  shifts           Shift[]
  timeEntries      TimeEntry[]
  assetCheckouts   AssetCheckout[]
  timeOffAllowance Json                       @default("{}")
  locationId       String?
  orgUnitId        String?
  orgUnit          OrgUnit?                   @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  coachingNotes    CoachingNote[]
  calendarToken    String?                    @unique
  smsOptIn         Boolean                    @default(false)

  @@unique([workspaceId, staffCode])
  @@index([workspaceId, status])
  @@index([workspaceId, departmentId])
}

model Course {
  id                String   @id @default(cuid())
  workspaceId       String
  title             String
  description       String   @default("")
  category          String   @default("General")
  passingScore      Int      @default(85)
  cooldownMinutes   Int      @default(15)
  isRemedial        Boolean  @default(false)
  isPublished       Boolean  @default(false)
  validityDays      Int?
  defaultDueDays    Int      @default(14)
  createdAt         DateTime @default(now())
  /// Quiz bank: ask this many questions, picked at random from all of them. Empty means ask every question.
  quizQuestionCount Int?
  shuffleQuestions  Boolean  @default(false)
  shuffleOptions    Boolean  @default(false)
  /// Courses that must be passed before this one can be started.
  prerequisiteIds       String[] @default([])
  jurisdictionStates    String[] @default([])
  jurisdictionCountries String[] @default([])

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]
  questions   QuizQuestion[]
  enrollments CourseEnrollment[]
  attempts    QuizAttempt[]

  @@index([workspaceId])
}

model CourseLesson {
  id              String  @id @default(cuid())
  courseId        String
  orderIndex      Int
  title           String
  contentMarkdown String
  videoUrl        String?
  videoProvider   String?
  captionsUrl     String?
  minWatchPct     Int     @default(0)
  checkpoints     Json    @default("[]")
  minReadSeconds  Int     @default(30)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, orderIndex])
}

model QuizQuestion {
  id                 String @id @default(cuid())
  courseId           String
  orderIndex         Int
  prompt             String
  options            Json
  correctOptionIndex Int
  explanation        String @default("")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, orderIndex])
}

/// One sitting of a quiz. The server picks the questions and the option order when it starts, and grades against that pick.
model QuizAttempt {
  id          String    @id @default(cuid())
  workspaceId String
  courseId    String
  employeeId  String
  questionIds String[]
  /// questionId -> the original option indexes in the order they were shown
  optionOrder Json      @default("{}")
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  passed      Boolean?

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([courseId, submittedAt])
  @@index([employeeId, courseId])
}

/// One graded answer. The question text is copied, so analytics survive later edits to the quiz.
model QuizAnswer {
  id           String   @id @default(cuid())
  attemptId    String
  workspaceId  String
  courseId     String
  questionId   String
  prompt       String
  chosenIndex  Int
  correctIndex Int
  correct      Boolean
  options      Json     @default("[]")
  createdAt    DateTime @default(now())

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([courseId, questionId])
  @@index([workspaceId, courseId])
}

model CourseEnrollment {
  id              String           @id @default(cuid())
  workspaceId     String
  employeeId      String
  courseId        String
  status          EnrollmentStatus @default(ASSIGNED)
  bestScore       Int?
  attemptsCount   Int              @default(0)
  lastAttemptAt   DateTime?
  assignedReason  String           @default("")
  dueDate         DateTime?
  completedAt     DateTime?
  certificateCode String?          @unique
  expiresAt       DateTime?
  reminderSentAt  DateTime?
  reminderStage   Int              @default(0)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee  EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([employeeId, courseId])
  @@index([workspaceId])
}

model InfractionCase {
  id                       String    @id @default(cuid())
  workspaceId              String
  caseNumber               String
  employeeId               String
  issuedByMemberId         String
  severity                 Severity
  pointsAdded              Int       @default(0)
  policyViolated           String
  summary                  String
  evidenceUrls             String[]
  confidentialManagerNotes String    @default("")
  employeeAcknowledged     Boolean   @default(false)
  employeeSignatureName    String?
  acknowledgedAt           DateTime?
  assignedRemedialCourseId String?
  createdAt                DateTime  @default(now())

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee    EmployeeProfile           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy    WorkspaceMember           @relation("IssuedBy", fields: [issuedByMemberId], references: [id])
  timeline    InfractionTimelineEvent[]
  attachments CaseAttachment[]
  appeals     Appeal[]

  @@unique([workspaceId, caseNumber])
  @@index([workspaceId, createdAt])
  @@index([employeeId])
}

model InfractionTimelineEvent {
  id             String            @id @default(cuid())
  caseId         String
  actorMemberId  String?
  actorName      String            @default("System")
  eventType      TimelineEventType
  note           String            @default("")
  isConfidential Boolean           @default(false)
  createdAt      DateTime          @default(now())

  case InfractionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model ShiftChecklistTemplate {
  id           String    @id @default(cuid())
  workspaceId  String
  departmentId String?
  shiftType    ShiftType
  title        String
  items        Json

  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department   Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  submissions  ShiftChecklistSubmission[]
  scheduleDays Int[]
  dueTime      String?

  @@index([workspaceId])
}

model ShiftChecklistSubmission {
  id                    String    @id @default(cuid())
  workspaceId           String
  templateId            String
  completedByEmployeeId String
  completedItems        Json
  handoffNotes          String    @default("")
  submittedAt           DateTime  @default(now())
  verifiedByName        String?
  verifiedAt            DateTime?

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  ShiftChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employee  EmployeeProfile        @relation(fields: [completedByEmployeeId], references: [id], onDelete: Cascade)
  photos    ChecklistPhoto[]

  @@index([workspaceId, submittedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String
  actorMemberId String?
  actorName     String
  actionType    String
  targetType    String
  targetId      String
  summary       String
  metadata      Json     @default("{}")
  hash          String
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

model SupportRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  topic       String
  message     String
  status      String   @default("OPEN")
  source      String   @default("CONTACT")
  chatTokenHash String?
  workspaceId String?
  userId      String?
  assignee    String?
  boardStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priority      String    @default("NORMAL")
  tags          String[]  @default([])
  category      String?
  sentiment     String?
  aiSummary     String?
  resolvedHint  Boolean   @default(false)
  triagedAt     DateTime?
  inbox         String?
  pageUrl       String?
  spam          Boolean   @default(false)
  mergedIntoId  String?
  linkedIds     String[]  @default([])
  solvedAt      DateTime?
  staffSeenAt   DateTime?
  staffSeenBy   String?
  staffTypingAt DateTime?
  staffTypingBy String?
  idleNudgedAt  DateTime?
  rating        Int?
  ratingNote    String?
  ratedAt       DateTime?

  messages     SupportMessage[]
  attachments  SupportAttachment[]
  roadmapTitle String?
  roadmapBlurb String?

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([workspaceId])
  @@index([mergedIntoId])
}

/// Someone who asked for the newsletter. They confirm by email before anything is sent (PENDING until then).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("PENDING")
  /// A long random token for the confirm and unsubscribe links. It identifies the subscription and nothing else.
  token          String    @unique
  source         String    @default("website")
  lastSentPostId String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

/// A newsletter issue. A published issue appears on the website; sending it by email is a separate step.
model NewsletterPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String    @default("")
  category    String    @default("Update")
  body        String
  status      String    @default("DRAFT")
  publishedAt DateTime?
  sentAt      DateTime?
  sentTo      Int       @default(0)
  sentFailed  Int       @default(0)
  authorName  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// One send from the staff console's email composer (a test, a single message or a broadcast). Counts only, no message text.
model EmailCampaign {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  staffName  String
  audience   String
  target     String   @default("")
  subject    String
  templateId String?
  category   String   @default("")
  total      Int      @default(0)
  delivered  Int      @default(0)
  failed     Int      @default(0)
  skipped    Int      @default(0)
  status     String   @default("SENDING")

  @@index([createdAt])
}

/// A reply template staff saved from the composer, next to the built-in library.
model EmailTemplate {
  id         String   @id @default(cuid())
  title      String
  category   String   @default("Custom")
  subject    String
  body       String
  icon       String   @default("chat")
  buttonText String   @default("")
  buttonUrl  String   @default("")
  createdBy  String
  createdAt  DateTime @default(now())
}

model SupportAttachment {
  id        String   @id @default(cuid())
  requestId String
  messageId String?
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model SupportCanned {
  id        String   @id @default(cuid())
  title     String
  body      String
  grp       String   @default("Custom")
  createdBy String
  createdAt DateTime @default(now())
}

model SupportBlock {
  email     String   @id
  reason    String   @default("")
  createdBy String
  createdAt DateTime @default(now())
}

model SupportConfig {
  id        String   @id @default("main")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model SupportDaily {
  day         String @id
  chats       Int    @default(0)
  aiReplies   Int    @default(0)
  escalations Int    @default(0)
  tickets     Int    @default(0)
}

model SupportCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  requestId  String
  kind       String
  authorName String
  body       String
  emailed    Boolean  @default(false)
  createdAt  DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

