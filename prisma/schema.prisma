  id              String   @id @default(cuid())
  investigationId String
  /// INTERVIEW | EVIDENCE | NOTE | WITNESS
  kind            String   @default("NOTE")
  authorName      String
  subjectName     String   @default("")
  content         String   @default("")
  fileId          String?
  fileName        String?
  fileSha256      String?
  isPrivileged    Boolean  @default(false)
  createdAt       DateTime @default(now())

  investigation InvestigationCase @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
}

