model InvestigationCase {
  id                   String    @id @default(cuid())
  workspaceId          String
  caseNumber           String
  title                String
  /// HARASSMENT | THEFT | WHISTLEBLOWER | SAFETY | POLICY | OTHER
  category             String    @default("HARASSMENT")
  /// OPEN | FROZEN | CLOSED
  status               String    @default("OPEN")
  legalPrivilege       Boolean   @default(false)
  frozenAt             DateTime?
  frozenByName         String?
  leadInvestigatorId   String?
  leadInvestigatorName String    @default("")
  subjectEmployeeIds   String[]  @default([])
  witnessEmployeeIds   String[]  @default([])
  summary              String    @default("")
  findings             String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   InvestigationEntry[]

  @@unique([workspaceId, caseNumber])
  @@index([workspaceId, status, createdAt])
}

